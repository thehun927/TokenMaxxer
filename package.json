{
  "name": "tokenmaxxer",
  "version": "0.1.0",
  "description": "opencode plugin for session longevity & cross-session memory",
  "type": "module",
  "files": [
    "bin/tokenmaxxer",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/tui.js",
    "dist/tui.d.ts",
    "dist/cli.js",
    "dist/cli.d.ts",
    "install.sh",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "bin": {
    "tokenmaxxer": "./bin/tokenmaxxer"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/tui.tsx --format esm --dts --no-splitting --clean --external @opencode-ai/plugin --external @opencode-ai/plugin/tui --external @opentui/solid --external @opentui/core --external @opentui/keymap --external zod && tsup src/cli.ts --format esm --target node18 --out-dir dist --dts --no-splitting && npm run check-cli-bundle",
    "build:cli": "tsup src/cli.ts --format esm --target node18 --out-dir dist --dts --no-splitting",
    "check-cli-bundle": "test -s dist/cli.js || (echo 'missing dist/cli.js' >&2; exit 1)",
    "verify-cli-bundle": "bash -n install.sh && bash -n bin/tokenmaxxer && npm run check-cli-bundle && grep -q 'CLI_PLUGIN_URL=.*dist/cli.js' install.sh && echo 'verify-cli-bundle: OK'",
    "smoke:cli": "bash test/cli-smoke/smoke.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:host-contract": "tsc -p tsconfig.host-contract.json --noEmit",
    "verify:host-contract": "node scripts/verify-host-contract.mjs && npm run typecheck:host-contract"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.15 <2.0.0",
    "@opentui/core": ">=0.4.5",
    "@opentui/keymap": ">=0.4.5",
    "@opentui/solid": ">=0.4.5",
    "zod": ">=3.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.15",
    "@opentui/core": "^0.4.5",
    "@opentui/keymap": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "@types/node": "^26.2.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0",
    "zod": "^3.0.0"
  }
}
