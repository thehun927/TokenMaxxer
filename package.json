{
  "name": "tokenmaxxer",
  "version": "0.1.0",
  "description": "opencode plugin for session longevity & cross-session memory",
  "type": "module",
  "files": [
    "bin/tokenmaxxer",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/tui.js",
    "dist/tui.d.ts",
    "dist/cli.js",
    "dist/cli.d.ts",
    "install.sh",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.23.1"
  },
  "packageManager": "npm@10.9.8",
  "main": "./dist/index.js",
  "bin": {
    "tokenmaxxer": "./bin/tokenmaxxer"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && npm run build:tui && npm run build:tui-decl && tsup src/index.ts --format esm --dts --no-splitting --external @opencode-ai/plugin --external @opencode-ai/plugin/tui --external @opentui/solid --external @opentui/core --external @opentui/keymap --external zod && tsup src/cli.ts --format esm --target node18 --out-dir dist --dts --no-splitting && npm run check:tui-bundle && npm run check-cli-bundle && rm -rf dist/memory dist/util",
    "build:tui": "bun run scripts/build-tui.ts",
    "build:tui-decl": "tsc --emitDeclarationOnly --declaration --outDir dist --project tsconfig.tui-decl.json",
    "check:tui-bundle": "node scripts/check-tui-bundle.mjs",
    "build:cli": "tsup src/cli.ts --format esm --target node18 --out-dir dist --dts --no-splitting",
    "check-cli-bundle": "test -s dist/cli.js || (echo 'missing dist/cli.js' >&2; exit 1)",
    "verify-cli-bundle": "bash -n install.sh && bash -n bin/tokenmaxxer && npm run check-cli-bundle && grep -q 'CLI_PLUGIN_URL=.*dist/cli.js' install.sh && echo 'verify-cli-bundle: OK'",
    "smoke:cli": "bash test/cli-smoke/smoke.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:host-contract": "tsc -p tsconfig.host-contract.json --noEmit",
    "verify:host-contract": "node scripts/verify-host-contract.mjs && npm run typecheck:host-contract",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:reproducible-build": "node scripts/verify-reproducible-build.mjs",
    "audit:release": "npm audit --audit-level=high && npm audit --omit=dev --audit-level=low",
    "release:preflight": "node scripts/release-preflight.mjs --tag v$npm_package_version --commit $(git rev-parse HEAD)",
    "release:stage": "node scripts/release-stage.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "release:dry-run": "npm run release:stage -- --tag v$npm_package_version --commit $(git rev-parse HEAD) --out .release && npm run release:verify -- --dir .release --tag v$npm_package_version --commit $(git rev-parse HEAD)"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.15 <2.0.0",
    "@opentui/core": ">=0.4.5",
    "@opentui/keymap": ">=0.4.5",
    "@opentui/solid": ">=0.4.5",
    "zod": ">=3.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.15",
    "@opentui/core": "^0.4.5",
    "@opentui/keymap": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "@types/node": "^26.2.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10",
    "zod": "^3.0.0"
  }
}
