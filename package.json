{
  "name": "tokenmaxxer",
  "version": "0.1.0",
  "description": "opencode plugin for session longevity & cross-session memory",
  "type": "module",
  "files": [
    "bin/tokenmaxxer",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/tui.js",
    "dist/tui.d.ts",
    "install.sh",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "bin": {
    "tokenmaxxer": "./bin/tokenmaxxer"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/tui.tsx --format esm --dts --no-splitting --clean --external @opencode-ai/plugin --external @opencode-ai/plugin/tui --external @opentui/solid --external @opentui/core --external @opentui/keymap --external zod",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0 <2.0.0",
    "@opentui/core": ">=0.4.5",
    "@opentui/keymap": ">=0.4.5",
    "@opentui/solid": ">=0.4.5",
    "zod": ">=3.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.15",
    "@opentui/core": "^0.4.5",
    "@opentui/keymap": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0",
    "zod": "^3.0.0"
  }
}
