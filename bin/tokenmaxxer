#!/usr/bin/env bash
set -euo pipefail

RECEIPT_FILE="${HOME}/.config/opencode/tokenmaxxer-release.json"

usage() {
  printf 'Usage: tokenmaxxer {version|opencode|decisions|promote|supersede} [args...]\n' >&2
}

show_version() {
  if [ ! -s "$RECEIPT_FILE" ]; then
    printf 'tokenmaxxer version: unavailable (no release receipt)\n'
    return 0
  fi
  if ! command -v node >/dev/null 2>&1; then
    printf 'tokenmaxxer version: unavailable (Node.js cannot read release receipt)\n'
    return 0
  fi
  RECEIPT_FILE="$RECEIPT_FILE" node <<'NODE'
const fs = require("node:fs")
try {
  const value = JSON.parse(fs.readFileSync(process.env.RECEIPT_FILE, "utf8"))
  if (value.schema_version !== 1 || typeof value.version !== "string" ||
      value.tag !== `v${value.version}` || !/^[0-9a-f]{40}$/.test(value.commit)) throw new Error("invalid receipt")
  console.log(`tokenmaxxer ${value.version} (${value.tag}, ${value.commit})`)
} catch {
  console.log("tokenmaxxer version: unavailable (invalid release receipt)")
}
NODE
}

find_cli() {
  local script_dir npm_bundle plugin_bundle
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  npm_bundle="${script_dir}/../dist/cli.js"
  plugin_bundle="${HOME}/.config/opencode/plugins/tokenmaxxer-cli.js"
  if [ -s "$npm_bundle" ]; then printf '%s\n' "$npm_bundle"; return 0; fi
  if [ -s "$plugin_bundle" ]; then printf '%s\n' "$plugin_bundle"; return 0; fi
  return 1
}

case "${1-}" in
  version) show_version;;
  opencode) shift; export TOKENMAXXER_LLM_EXTRACT=1; exec opencode "$@";;
  decisions|promote|supersede)
    if ! CLI_BUNDLE="$(find_cli)"; then
      printf 'tokenmaxxer: CLI bundle not found; release identity is unavailable. Re-run the immutable release installer.\n' >&2
      exit 3
    fi
    exec node "$CLI_BUNDLE" "$@"
    ;;
  *) usage; exit 2;;
esac
